          {agentLogos.map((name, index) => (
            <span class="doc__pop-tile opacity-0 [transform:scale(0.6)] [transition:opacity_0.2s_ease,_transform_0.25s_cubic-bezier(0.22,_1,_0.36,_1)] [transition-delay:calc(var(--i,_0)_*_28ms)] [.doc\_\_pop:hover_&]:opacity-100 [.doc\_\_pop:hover_&]:[transform:scale(1)] [.doc\_\_pop:focus-within_&]:opacity-100 [.doc\_\_pop:focus-within_&]:[transform:scale(1)] inline-flex items-center justify-center w-8.5 h-8.5 border border-rule rounded-[8px] bg-surface [&_img]:w-4.5 [&_img]:h-4.5 [&_img]:object-contain [@media(prefers-reduced-motion:_reduce)]:[transition:none]" style={`--i:${index}`}><img src={logo(name)} alt="" width="18" height="18" /></span>
          ))}
          <span class="doc__pop-pill opacity-0 [transform:scale(0.6)] [transition:opacity_0.2s_ease,_transform_0.25s_cubic-bezier(0.22,_1,_0.36,_1)] [transition-delay:calc(var(--i,_0)_*_28ms)] [.doc\_\_pop:hover_&]:opacity-100 [.doc\_\_pop:hover_&]:[transform:scale(1)] [.doc\_\_pop:focus-within_&]:opacity-100 [.doc\_\_pop:focus-within_&]:[transform:scale(1)] inline-flex items-center h-8.5 py-0 px-[10px] border border-rule rounded-[8px] font-mono text-[11.5px] [color:var(--color-ink-2)] whitespace-nowrap [@media(prefers-reduced-motion:_reduce)]:[transition:none]" style={`--i:${agentLogos.length}`}>any MCP client</span>

---
// Dotted phrases reveal examples of tools and supported agents.
const logos = import.meta.glob<string>("../../assets/logos/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});
const logo = (name: string): string => {
  const hit = Object.entries(logos).find(([path]) => path.endsWith(`/${name}.svg`));
  if (!hit) throw new Error(`missing logo ${name}`);
  return hit[1];
};
const serverLogos = ["linear", "notion", "sentry"];
const agentLogos = ["claude", "codex", "cursor", "chatgpt", "gemini", "hermes", "copilot", "windsurf", "opencode", "zed", "grok"];
---

<ol class="doc__steps grid gap-[0.55rem] [margin:0.25rem_0_1rem] text-[17px] leading-[1.5] text-ink [&_li]:grid [&_li]:grid-cols-[2rem_1fr] [&_li]:gap-[0.25rem] [&_li]:items-baseline [&_a]:text-ink [&_a]:underline [&_a]:underline-offset-[4px] [&_a]:[text-decoration-color:var(--color-rule-strong)] [&_a:hover]:[text-decoration-color:var(--color-ink)] max-[719.98px]:text-[16px] max-[719.98px]:[&_li]:grid-cols-[1.75rem_1fr] max-[1023.98px]:justify-center max-[1023.98px]:[&_li]:flex max-[1023.98px]:[&_li]:justify-center max-[1023.98px]:[&_li]:gap-[0.6rem]">
  <li>
    <span class="doc__num font-mono text-[11px] tracking-[0.08em] [color:var(--color-ink-3)] pt-[0.25rem]">01</span>
    <span>Pick something you want your agent to do.</span>
  </li>
  <li>
    <span class="doc__num font-mono text-[11px] tracking-[0.08em] [color:var(--color-ink-3)] pt-[0.25rem]">02</span>
    <span>
      Bring{" "}
      <span class="doc__pop relative inline-block [outline:none] max-[719.98px]:static" tabindex="0">
        <span class="doc__pop-word font-semibold underline [text-decoration-style:dotted] underline-offset-[4px] [text-decoration-color:var(--color-ink-3)] cursor-default [.doc\_\_pop:hover_&]:[text-decoration-style:solid] [.doc\_\_pop:hover_&]:[text-decoration-color:var(--color-ink)] [.doc\_\_pop:focus-visible_&]:[text-decoration-style:solid] [.doc\_\_pop:focus-visible_&]:[text-decoration-color:var(--color-ink)]">a tool</span>
        <span class="doc__pop-panel absolute left-0 top-[calc(100%_+_8px)] z-20 flex-wrap gap-1.5 w-[max-content] max-w-105 p-[8px] border border-rule rounded-[10px] bg-surface [box-shadow:0_1px_2px_rgba(13,_13,_16,_0.04),_0_12px_32px_-12px_rgba(13,_13,_16,_0.18)] opacity-0 pointer-events-none hidden [transform:translateY(-4px)] [transition:opacity_0.15s_ease,_transform_0.15s_ease,_visibility_0s_linear_0.15s] [.doc\_\_pop:hover_&]:opacity-100 [.doc\_\_pop:hover_&]:pointer-events-auto [.doc\_\_pop:hover_&]:visible [.doc\_\_pop:hover_&]:[transform:translateY(0)] [.doc\_\_pop:hover_&]:[transition-delay:0s] [.doc\_\_pop:focus-within_&]:opacity-100 [.doc\_\_pop:focus-within_&]:pointer-events-auto [.doc\_\_pop:focus-within_&]:visible [.doc\_\_pop:focus-within_&]:[transform:translateY(0)] [.doc\_\_pop:focus-within_&]:[transition-delay:0s] [@media(prefers-reduced-motion:_reduce)]:[transition:none] max-[719.98px]:fixed max-[719.98px]:left-[1rem] max-[719.98px]:right-[1rem] max-[719.98px]:top-16 max-[719.98px]:w-auto max-[719.98px]:max-w-none max-[1023.98px]:text-left" aria-hidden="true" inert>
